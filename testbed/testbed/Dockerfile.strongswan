FROM alpine:3.19

RUN apk add --no-cache \
    strongswan \
    iproute2 \
    iperf3 \
    python3 \
    curl

# Prevent strongSwan from bypassing local Docker bridge traffic.
RUN rm -f /etc/strongswan.d/charon/bypass-lan.conf

RUN mkdir -p /etc/swanctl/conf.d

ENV PYTHONUNBUFFERED=1

HEALTHCHECK --interval=2s --timeout=1s --retries=10 \
    CMD pidof charon > /dev/null 2>&1 || exit 1

CMD ["/usr/lib/strongswan/charon"]
