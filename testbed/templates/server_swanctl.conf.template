connections {
    rw {
        local_addrs  = 10.0.0.2
        
        local {
            auth = psk
            id = server.vpn.local
        }
        remote {
            auth = psk
            id = client.vpn.local
        }
        
        children {
            net {
                local_ts  = 10.0.0.2/32
                remote_ts = 10.0.0.3/32
                
                # Jinja2 variables for ESP proposals and mode
                esp_proposals = {{ esp_proposals }}
                mode = {{ mode }}
            }
        }
        
        version = 2
        proposals = {{ ike_proposals }}
    }
}

secrets {
    ike-psk {
        id-server = server.vpn.local
        id-client = client.vpn.local
        secret = "HackathonSecretKey2026"
    }
}
