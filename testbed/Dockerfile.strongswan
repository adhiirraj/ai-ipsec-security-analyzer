FROM alpine:3.19

RUN apk update && \
    apk add --no-cache \
    strongswan \
    strongswan-swanctl \
    iproute2 \
    tcpdump \
    iperf3 \
    python3 \
    curl \
    socat

# Disable the bypass-lan plugin which prevents IPsec from encrypting local Docker bridge traffic
RUN rm -f /etc/strongswan.d/charon/bypass-lan.conf

# Create directory for swanctl configs
RUN mkdir -p /etc/swanctl/conf.d

COPY scripts/start-server-workloads.sh /usr/local/bin/start-server-workloads
RUN chmod 0755 /usr/local/bin/start-server-workloads

# charon is the IKE daemon. We run it in the foreground.
CMD ["charon"]
