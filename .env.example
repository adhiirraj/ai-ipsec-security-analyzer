# Maximum number of IPsec packet observations retained in a JSON report.
# The analyzer still counts every packet while streaming the capture.
IPSEC_SENTINEL_MAX_PACKET_OBSERVATIONS=10000
IPSEC_SENTINEL_MAX_CAPTURED_PACKET_BYTES=16777216
# Maximum raw PCAP upload accepted by the dashboard API.
IPSEC_SENTINEL_MAX_UPLOAD_BYTES=33554432
# Bind the dashboard locally by default; change only for a deliberate deployment.
IPSEC_SENTINEL_API_HOST=127.0.0.1
# Runtime-only generated strongSwan configs and captures. Do not point this at tracked source directories.
IPSEC_SENTINEL_TESTBED_RUNTIME_DIR=testbed/runtime
IPSEC_SENTINEL_PCAP_DIR=testbed/runtime/pcaps
# Comma-separated API origins when serving the frontend separately.
IPSEC_SENTINEL_CORS_ORIGINS=http://localhost:8000
